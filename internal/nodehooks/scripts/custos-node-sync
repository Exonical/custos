#!/bin/bash
# custos-node-sync: pulls the node bundle from Custos and installs it.
#
# Config: /etc/custos/agent.conf (root-owned, 0600), key=value lines:
#   CUSTOS_URL=https://custos.example.org
#   CUSTOS_TOKEN_FILE=/etc/custos/node-token   (root 0600, never in the bundle)
#   CUSTOS_CA_FILE=/etc/custos/ca.pem          (optional)
#   CUSTOS_NODE_NAME=c1                        (optional; default: hostname -s)
#
# Releases live under /var/lib/custos-node/releases/<sha256>; /etc/custos/node
# is a symlink that is flipped with an atomic rename. Generated by Custos.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

CONF=/etc/custos/agent.conf
STATE=/var/lib/custos-node
LINK=/etc/custos/node

log() { logger -t custos-node-sync -- "$*" || true; }
die() {
	log "ERROR: $*"
	echo "custos-node-sync: $*" >&2
	exit 1
}

[ -r "$CONF" ] || die "missing $CONF"
CUSTOS_URL=
CUSTOS_TOKEN_FILE=
CUSTOS_CA_FILE=
CUSTOS_NODE_NAME=
while IFS='=' read -r key value; do
	case "$key" in
	CUSTOS_URL) CUSTOS_URL=$value ;;
	CUSTOS_TOKEN_FILE) CUSTOS_TOKEN_FILE=$value ;;
	CUSTOS_CA_FILE) CUSTOS_CA_FILE=$value ;;
	CUSTOS_NODE_NAME) CUSTOS_NODE_NAME=$value ;;
	esac
done <"$CONF"

[ -n "$CUSTOS_URL" ] || die "CUSTOS_URL not set"
[ -r "$CUSTOS_TOKEN_FILE" ] || die "token file unreadable"
node=${CUSTOS_NODE_NAME:-$(hostname -s)}
case "$node" in
'' | *[!A-Za-z0-9._-]*) die "invalid node name" ;;
esac

mkdir -p "$STATE/releases" /run/custos
chmod 0700 -- "$STATE" "$STATE/releases"
(umask 022 && mkdir -p /etc/custos)
exec 8>/run/custos/sync.lock
flock -n 8 || exit 0

tmp=$(mktemp -d "$STATE/tmp.XXXXXX")
NEWLINK=/etc/custos/.node.new
trap 'rm -rf -- "$tmp"; rm -f -- "$NEWLINK"' EXIT

token=$(<"$CUSTOS_TOKEN_FILE")
{
	printf 'Authorization: Bearer %s\n' "$token"
	printf 'X-Custos-Node: %s\n' "$node"
	if [ -r "$STATE/etag" ] && [ -e "$LINK" ]; then
		printf 'If-None-Match: "%s"\n' "$(<"$STATE/etag")"
	fi
} >"$tmp/headers"
token=

curl_args=(--silent --show-error --fail --max-time 60
	--dump-header "$tmp/resp-headers" --output "$tmp/bundle.tgz"
	--header "@$tmp/headers" --write-out '%{http_code}')
if [ -n "$CUSTOS_CA_FILE" ]; then
	curl_args+=(--cacert "$CUSTOS_CA_FILE")
fi
code=$(curl "${curl_args[@]}" "${CUSTOS_URL%/}/api/v1/node/bundle") || die "bundle request failed"
rm -f -- "$tmp/headers"

if [ "$code" = 304 ]; then
	exit 0
fi
[ "$code" = 200 ] || die "unexpected HTTP status $code"

etag=$(sed -n 's/^[Ee][Tt][Aa][Gg]: *"\{0,1\}\([0-9a-f]\{64\}\)"\{0,1\}\r\{0,1\}$/\1/p' "$tmp/resp-headers" | tail -n1)
[ -n "$etag" ] || die "response has no valid ETag"
actual=$(sha256sum "$tmp/bundle.tgz" | cut -d' ' -f1)
[ "$actual" = "$etag" ] || die "bundle sha256 does not match ETag"

while IFS= read -r entry; do
	case "$entry" in
	/* | *..*) die "unsafe path in bundle: $entry" ;;
	esac
done < <(tar -tzf "$tmp/bundle.tgz")

mkdir "$tmp/x"
tar -xzf "$tmp/bundle.tgz" -C "$tmp/x" --no-same-owner
src="$tmp/x/etc/custos/node"
[ -f "$src/mounts.tsv" ] || die "bundle has no mounts.tsv"

while IFS= read -r -d '' script; do
	bash -n "$script" || die "syntax check failed: ${script#"$src"/}"
done < <(find "$src" -type f \( -path '*/prolog.d/*' -o -path '*/epilog.d/*' -o -name '*.sh' -o -name custos-node-sync \) -print0)

rel="$STATE/releases/$etag"
rm -rf -- "$rel"
mkdir -p -- "$rel"
cp -a -- "$src/." "$rel/"
# The tree names every tenant's shares; keep it root-only even when the bundle
# comes from an older Custos that shipped 0644/0755 modes.
chmod -R go-rwx -- "$rel"

if [ -e "$LINK" ] && [ ! -L "$LINK" ]; then
	mv -- "$LINK" "$LINK.pre-custos-agent"
	chmod -R go-rwx -- "$LINK.pre-custos-agent"
fi
# The temporary link lives next to $LINK so the final rename stays on one
# filesystem and is atomic.
ln -sfn -- "$rel" "$NEWLINK"
mv -T -- "$NEWLINK" "$LINK"
printf '%s\n' "$etag" >"$STATE/etag"

# Keep the three newest releases.
# shellcheck disable=SC2012
ls -1t "$STATE/releases" | tail -n +4 | while IFS= read -r old; do
	[ "$old" = "$etag" ] || rm -rf -- "${STATE:?}/releases/$old"
done

revision=$(awk -F'\t' '$1=="meta" && $2=="revision" {print $3}' "$src/mounts.tsv")
log "installed bundle revision ${revision:-unknown} ($etag)"
