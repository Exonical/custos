{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custos.io/schemas/workflow/v1alpha1",
  "title": "Custos Workflow",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "custos.io/v1alpha1"},
    "kind": {"const": "Workflow"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "spec": {
      "type": "object",
      "required": ["tasks"],
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        },
        "placement": {"$ref": "#/$defs/placement"},
        "defaults": {"$ref": "#/$defs/defaults"},
        "secrets": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/secretUse"}
        },
        "execution": {"$ref": "#/$defs/execution"},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/task"}
        }
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["string", "integer", "boolean"]},
        "required": {"type": "boolean"},
        "default": {},
        "pattern": {"type": "string"},
        "minimum": {"type": "integer"},
        "maximum": {"type": "integer"},
        "enum": {"type": "array"}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {"type": "string"},
        "requirements": {"type": "object"}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {"type": ["string", "null"]},
        "partition": {"type": "string"},
        "qos": {"type": "string"},
        "workingDirectory": {"type": "string"},
        "env": {
          "oneOf": [
            {"type": "object", "additionalProperties": {"type": "string"}},
            {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*="}}
          ]
        }
      }
    },
    "secretUse": {
      "type": "object",
      "required": ["ref", "use"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string"},
        "use": {"enum": ["env", "wrapped_token"]},
        "envName": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["auto", "engine", "native"]},
        "failurePolicy": {"enum": ["fail", "continue"]}
      }
    },
    "fanOut": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {"type": ["integer", "string"]},
        "from": {"type": "string"}
      }
    },
    "retry": {
      "type": "object",
      "required": ["attempts"],
      "additionalProperties": false,
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "on": {
          "type": "array",
          "items": {"enum": ["FAILED", "NODE_FAIL", "TIMEOUT"]}
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["file"]},
        "path": {"type": "string"}
      }
    },
    "taskResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 0},
        "cpuAffinity": {"enum": ["none", "core", "socket", "numa"]},
        "memory": {"type": "string"},
        "walltime": {"type": "string"},
        "gpu": {"$ref": "#/$defs/gpuRequest"},
        "nodes": {"type": "integer", "minimum": 0},
        "tasks": {"type": "integer", "minimum": 0},
        "tasksPerNode": {"type": "integer", "minimum": 0},
        "cpusPerTask": {"type": "integer", "minimum": 0},
        "memoryPerNode": {"type": "string"},
        "licenses": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "string"},
        "exclusive": {"type": "boolean"}
      }
    },
    "gpuRequest": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "arraySpec": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "step": {"type": "integer", "minimum": 0},
        "maxConcurrent": {"type": "integer", "minimum": 0}
      }
    },
    "scriptRef": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "language": {"enum": ["bash", "sh", "python", "yaml", "json"]},
            "inline": {"type": "string", "minLength": 1, "maxLength": 262144}
          },
          "oneOf": [
            {"required": ["ref", "language"], "not": {"required": ["inline"]}},
            {"required": ["inline"], "not": {"required": ["ref"]}}
          ]
        }
      ]
    },
    "image": {
      "type": "object",
      "required": ["uri"],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(docker|oras)://[A-Za-z0-9._/:@+-]+$|^/[A-Za-z0-9._/+-]+$",
          "not": {"pattern": "(^|/)\\.\\.(?:/|$)"}
        }
      }
    },
    "multinode": {
      "type": "object",
      "required": ["nodes", "implementation"],
      "additionalProperties": false,
      "properties": {
        "nodes": {"type": "integer", "minimum": 1, "maximum": 10000},
        "implementation": {"enum": ["openmpi", "mpich", "generic"]},
        "procsPerNode": {"type": "integer", "minimum": 1}
      }
    },
    "softwareRequirement": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "task": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "type": {
          "enum": ["batch", "mpi", "gpu", "array", "shell", "stageIn", "stageOut", "interactive", "condition"],
          "deprecated": true,
          "description": "Deprecated compatibility aliases. New specs should omit type except for shell and condition; use launch to choose sbatch or srun."
        },
        "launch": {"type": "string", "enum": ["sbatch", "srun"], "description": "Slurm launch model; defaults to sbatch, except legacy type mpi defaults to srun."},
        "dependsOn": {"type": "array", "items": {"type": "string"}},
        "onDependencyFailure": {"enum": ["fail", "run"]},
        "when": {"type": "string"},
        "fanOut": {"$ref": "#/$defs/fanOut"},
        "resources": {"$ref": "#/$defs/taskResources"},
        "placement": {"$ref": "#/$defs/placement"},
        "image": {"$ref": "#/$defs/image"},
        "multinode": {"$ref": "#/$defs/multinode"},
        "command": {"type": "array", "items": {"type": "string"}},
        "script": {"$ref": "#/$defs/scriptRef"},
        "args": {"type": "array", "items": {"type": "string"}},
        "env": {
          "oneOf": [
            {"type": "object", "additionalProperties": {"type": "string"}},
            {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*="}}
          ]
        },
        "software": {"type": "array", "items": {"$ref": "#/$defs/softwareRequirement"}},
        "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/output"}},
        "retry": {"$ref": "#/$defs/retry"},
        "array": {"$ref": "#/$defs/arraySpec"},
        "partition": {"type": "string"},
        "qos": {"type": "string"},
        "workingDirectory": {"type": "string"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      }
    }
  }
}
