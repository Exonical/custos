{
  "realm": "custos",
  "enabled": true,
  "displayName": "Custos E2E",
  "sslRequired": "none",
  "registrationAllowed": false,
  "bruteForceProtected": false,
  "requiredActions": [],
  "roles": {
    "realm": [
      { "name": "offline_access" },
      { "name": "uma_authorization" }
    ]
  },
  "groups": [
    { "name": "hpc-a", "path": "/hpc-a" },
    { "name": "hpc-admins", "path": "/hpc-admins" }
  ],
  "clients": [
    {
      "clientId": "custos-e2e",
      "enabled": true,
      "publicClient": false,
      "secret": "e2e-client-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {},
      "protocolMappers": [
        {
          "name": "custos-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "custos",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "custos-openbao",
      "enabled": true,
      "publicClient": false,
      "secret": "e2e-openbao-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "openbao-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "custos-openbao",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "custos-wrong-audience",
      "enabled": true,
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": []
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "web-origins",
    "acr",
    "basic",
    "role_list"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "microprofile-jwt",
    "address",
    "phone"
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@e2e.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Researcher",
      "credentials": [
        { "type": "password", "value": "alice-e2e-password", "temporary": false }
      ],
      "groups": ["/hpc-a"],
      "requiredActions": []
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@e2e.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Stranger",
      "credentials": [
        { "type": "password", "value": "bob-e2e-password", "temporary": false }
      ],
      "groups": [],
      "requiredActions": []
    },
    {
      "username": "platform-admin",
      "enabled": true,
      "email": "platform-admin@e2e.test",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "platform-admin-e2e-password", "temporary": false }
      ],
      "groups": ["/hpc-admins"],
      "requiredActions": []
    }
  ]
}
