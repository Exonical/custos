{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Custos chart values",
  "description": "Strict for chart-owned keys; config, postgresql and openbao are free-form (passthrough / subchart values).",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "key": {"type": "string"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "k8sMap": {"type": "object"},
    "k8sList": {"type": "array"},
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"}
      }
    }
  },
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "global": {
      "type": "object",
      "properties": {"imagePullSecrets": {"type": "array", "items": {"type": "object"}}}
    },
    "image": {"$ref": "#/definitions/image"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "config": {"type": "object"},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientSecret": {"$ref": "#/definitions/secretRef"},
            "caSecret": {"$ref": "#/definitions/secretRef"}
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrateURLSecret": {"$ref": "#/definitions/secretRef"},
        "appURLSecret": {"$ref": "#/definitions/secretRef"},
        "caSecret": {"$ref": "#/definitions/secretRef"},
        "appRole": {"type": "string", "pattern": "^([a-z_][a-z0-9_]{0,62})?$"},
        "sslMode": {"type": "string", "enum": ["require", "verify-ca", "verify-full"]}
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobNameSuffix": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$|^$"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "ttlSecondsAfterFinished": {"type": ["integer", "null"], "minimum": 0},
        "resources": {"type": "object"},
        "waitTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {"type": "string"},
            "caSecret": {"$ref": "#/definitions/secretRef"},
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {"type": "string"},
                    "kind": {"type": "string", "enum": ["Issuer", "ClusterIssuer"]},
                    "group": {"type": "string"}
                  }
                },
                "duration": {"type": "string"},
                "renewBefore": {"type": "string"},
                "dnsNames": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },
        "service": {"$ref": "#/definitions/service"}
      }
    },
    "serve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "topologySpreadConstraints": {"type": "array"},
        "extraEnv": {"type": "array"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "topologySpreadConstraints": {"type": "array"},
        "extraEnv": {"type": "array"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"type": "object"}
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "replicas": {"type": "integer", "minimum": 1},
        "publicOrigin": {"type": "string", "pattern": "^(https?://[^/?#]+)?$"},
        "issuer": {"type": "string"},
        "client": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "secret": {"$ref": "#/definitions/secretRef"}
          }
        },
        "authSecrets": {"$ref": "#/definitions/secretRef"},
        "idpCaSecret": {"$ref": "#/definitions/secretRef"},
        "apiURL": {"type": "string"},
        "trustedProxyHops": {"type": "integer", "minimum": 0},
        "service": {"$ref": "#/definitions/service"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "podLabels": {"type": "object"},
        "topologySpreadConstraints": {"type": "array"},
        "extraEnv": {"type": "array"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "autoscaling": {"$ref": "#/definitions/autoscaling"}
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}}
    },
    "openbaoClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "address": {"type": "string", "pattern": "^(https://[^\\s]+)?$"},
        "namespace": {"type": "string"},
        "timeout": {"type": "string"},
        "caSecret": {"$ref": "#/definitions/secretRef"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "workloadIdentity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "audience": {"type": "string", "minLength": 1},
                "expirationSeconds": {"type": "integer", "minimum": 600}
              }
            },
            "oidcClientCredentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "tokenURL": {"type": "string"},
                "clientID": {"type": "string"},
                "clientSecret": {"$ref": "#/definitions/secretRef"}
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "parentRefs": {"type": "array", "items": {"type": "object", "required": ["name"]}},
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostnames": {"type": "array", "items": {"type": "string"}},
            "annotations": {"type": "object"}
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "hostnames": {"type": "array", "items": {"type": "string"}},
            "annotations": {"type": "object"},
            "backendTLS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "apiVersion": {"type": "string"},
                "caConfigMap": {"type": "string"},
                "hostname": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "apiFrom": {"type": "array", "items": {"type": "object"}},
        "metricsFrom": {"type": "array", "items": {"type": "object"}},
        "webFrom": {"type": "array", "items": {"type": "object"}},
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "restrict": {"type": "boolean"},
            "dnsNamespaceSelector": {"type": "object"},
            "extra": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string"},
        "labels": {"type": "object"}
      }
    },
    "postgresql": {"type": "object"},
    "openbao": {"type": "object"}
  }
}
